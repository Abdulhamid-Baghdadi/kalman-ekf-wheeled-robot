    <collision name="collision">
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.035"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>10</mu>
            <mu2>10</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <visual name="front_left_wheel_visual">
