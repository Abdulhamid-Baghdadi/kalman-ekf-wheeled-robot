<?xml version="1.0" ?>
<!-- Copy of rosbot.urdf for the demo recording: wheel and lidar collision meshes replaced by cylinders
     so Gazebo runs in real time without a GPU. Visual meshes are unchanged. -->
<!-- =================================================================================== -->
<!-- |    This document was autogenerated by xacro from rosbot.xacro                   | -->
<!-- |    EDITING THIS FILE BY HAND IS NOT RECOMMENDED                                 | -->
