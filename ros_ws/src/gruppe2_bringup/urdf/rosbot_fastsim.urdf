    <origin rpy="0 0 3.14" xyz="0.02 0 0.058"/>
    <parent link="base_link"/>
    <child link="laser"/>
  </joint>
  <!-- rplidar Laser -->
  <link name="laser">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
